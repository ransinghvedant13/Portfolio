# Server
PORT=5000
CLIENT_ORIGIN=http://localhost:5173

# Email (used by /api/contact to forward messages to your inbox)
# If you use Gmail: enable 2FA then create an "App Password" - do not use your normal password.
SMTP_HOST=smtp.gmail.com
SMTP_PORT=465
SMTP_USER=your-email@gmail.com
SMTP_PASS=your-app-password
CONTACT_RECEIVER=your-email@gmail.com
